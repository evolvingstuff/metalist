{
  "version": 1,
  "allowed_tags": [
    "a",
    "b",
    "blockquote",
    "br",
    "cite",
    "code",
    "dd",
    "del",
    "div",
    "dl",
    "dt",
    "em",
    "h1",
    "h2",
    "h3",
    "h4",
    "h5",
    "h6",
    "hr",
    "i",
    "img",
    "li",
    "mark",
    "ol",
    "p",
    "pre",
    "q",
    "s",
    "small",
    "span",
    "strike",
    "strong",
    "sub",
    "sup",
    "table",
    "tbody",
    "td",
    "tfoot",
    "th",
    "thead",
    "tr",
    "u",
    "ul"
  ],
  "clean_content_tags": [
    "applet",
    "base",
    "button",
    "embed",
    "form",
    "iframe",
    "input",
    "link",
    "math",
    "meta",
    "noscript",
    "object",
    "option",
    "script",
    "select",
    "style",
    "svg",
    "template",
    "textarea"
  ],
  "allowed_attributes": {
    "*": ["style"],
    "a": ["href", "title"],
    "blockquote": ["cite"],
    "img": ["alt", "height", "src", "title", "width"],
    "li": ["value"],
    "ol": ["reversed", "start", "type"],
    "q": ["cite"],
    "td": ["colspan", "rowspan"],
    "th": ["colspan", "rowspan", "scope"]
  },
  "allowed_url_schemes": ["data", "http", "https", "mailto", "tel"],
  "allowed_style_properties": [
    "font-style",
    "font-weight",
    "height",
    "margin-left",
    "max-height",
    "max-width",
    "padding-left",
    "text-decoration",
    "text-decoration-line",
    "text-indent",
    "vertical-align",
    "white-space",
    "width"
  ],
  "block_style_properties": ["margin-left", "padding-left", "text-indent"],
  "image_style_properties": ["height", "max-height", "max-width", "width"],
  "max_data_image_bytes": 10485760
}

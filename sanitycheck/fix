#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(cd "$script_dir/.." && pwd)
config_path="$repo_root/sanitycheck/sanitycheck.config.json"

if [ ! -f "$config_path" ]; then
  echo "sanitycheck: missing config at $config_path" 1>&2
  exit 2
fi

if [ "$#" -eq 0 ]; then
  exec python3 "$repo_root/sanitycheck/fix.py"
fi

exec python3 "$repo_root/sanitycheck/python/fix.py" \
  --config "$config_path" \
  --repo-root "$repo_root" \
  "$@"

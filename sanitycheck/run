#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(cd "$script_dir/.." && pwd)
config_path="$repo_root/sanitycheck/sanitycheck.config.json"

if [ ! -f "$config_path" ]; then
  echo "sanitycheck: missing config at $config_path" 1>&2
  exit 2
fi

tmp_py=$(mktemp)
tmp_js=$(mktemp)

cleanup() {
  rm -f "$tmp_py" "$tmp_js"
}
trap cleanup EXIT

python3 - "$repo_root" "$config_path" "$tmp_py" "$tmp_js" "$@" <<'PY'
import fnmatch
import json
import os
import sys

repo_root = sys.argv[1]
config_path = sys.argv[2]
out_py = sys.argv[3]
out_js = sys.argv[4]
targets = sys.argv[5:]

with open(config_path, "r", encoding="utf-8") as handle:
    config = json.load(handle)

exclude_dot_folders = config["exclude_dot_folders"]
ignore_globs = config["ignore_globs"]

if exclude_dot_folders is not True:
    raise Exception("exclude_dot_folders must be true")
if not isinstance(ignore_globs, list):
    raise Exception("ignore_globs must be a list")

prune_names = {
    "sanitycheck",
    "node_modules",
    ".venv",
    "dist",
    "build",
    "coverage",
    "__pycache__",
}


def ignored(rel_path: str) -> bool:
    i = 0
    while i < len(ignore_globs):
        if fnmatch.fnmatch(rel_path, ignore_globs[i]):
            return True
        i += 1
    return False


py_ext = {".py"}
js_ext = {".js", ".jsx", ".ts", ".tsx"}

py_paths: list[str] = []
js_paths: list[str] = []


def add_file(rel_path: str) -> None:
    if rel_path.startswith("/"):
        raise Exception(f"Absolute paths are not allowed: {rel_path}")
    if rel_path.startswith("../") or "/../" in rel_path:
        raise Exception(f"Paths outside repo are not allowed: {rel_path}")

    if ignored(rel_path):
        return

    _, ext = os.path.splitext(rel_path)
    if ext in py_ext:
        py_paths.append(os.path.join(repo_root, rel_path))
    elif ext in js_ext:
        js_paths.append(os.path.join(repo_root, rel_path))


def walk_root(root_rel: str) -> None:
    root = os.path.join(repo_root, root_rel)
    for walk_root_abs, dirs, files in os.walk(root):
        rel_root = os.path.relpath(walk_root_abs, repo_root)
        if rel_root == ".":
            rel_root = ""

        kept_dirs: list[str] = []
        d = 0
        while d < len(dirs):
            name = dirs[d]

            if name in prune_names:
                d += 1
                continue
            if exclude_dot_folders and name.startswith("."):
                d += 1
                continue

            child_rel = name
            if rel_root != "":
                child_rel = rel_root + "/" + name
            if ignored(child_rel) or ignored(child_rel + "/"):
                d += 1
                continue

            kept_dirs.append(name)
            d += 1
        dirs[:] = kept_dirs

        f = 0
        while f < len(files):
            name = files[f]
            rel_path = name
            if rel_root != "":
                rel_path = rel_root + "/" + name
            add_file(rel_path)
            f += 1

if len(targets) == 0:
    walk_root("")
else:
    for raw in targets:
        rel = os.path.normpath(raw)
        if rel == ".":
            walk_root("")
            continue
        if rel.startswith("/"):
            raise Exception(f"Absolute paths are not allowed: {raw}")
        if rel.startswith("../") or rel.startswith("..\\"):
            raise Exception(f"Paths outside repo are not allowed: {raw}")

        abs_path = os.path.join(repo_root, rel)
        if os.path.isdir(abs_path):
            walk_root(rel)
        elif os.path.isfile(abs_path):
            add_file(rel)
        else:
            raise Exception(f"Target does not exist: {raw}")


def write_nul(paths: list[str], dest: str) -> None:
    with open(dest, "wb") as handle:
        i = 0
        while i < len(paths):
            handle.write(paths[i].encode("utf-8"))
            handle.write(b"\0")
            i += 1


write_nul(py_paths, out_py)
write_nul(js_paths, out_js)
PY

py_count=$(tr -cd '\0' < "$tmp_py" | wc -c | tr -d ' ')
js_count=$(tr -cd '\0' < "$tmp_js" | wc -c | tr -d ' ')

if [ "$py_count" -gt 0 ]; then
  python3 "$repo_root/sanitycheck/python/check.py" \
    --config "$config_path" \
    --repo-root "$repo_root" \
    --files0-from "$tmp_py" \
    --max-violations 200
fi

if [ "$js_count" -gt 0 ]; then
  eslint_bin="$repo_root/sanitycheck/js/node_modules/eslint/bin/eslint.js"
  if [ ! -f "$eslint_bin" ]; then
    echo "sanitycheck: missing $eslint_bin" 1>&2
    echo "sanitycheck: run 'cd sanitycheck/js && npm install'" 1>&2
    exit 2
  fi

  # shellcheck disable=SC2039
  xargs -0 node "$eslint_bin" --config "$repo_root/sanitycheck/js/eslint.config.mjs" < "$tmp_js"
fi

echo "sanitycheck: ok (py=$py_count js=$js_count)"
